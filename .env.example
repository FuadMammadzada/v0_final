# App
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_COMPLETE_108_PRICE_ID=price_complete_108
STRIPE_ONE_MORE_TRY_PRICE_ID=price_one_more_try

# Make.com server-side webhook URLs
MAKE_MANIFESTATION_WEBHOOK_URL=your-make-manifestation-webhook-url
MAKE_COMPLETE_108_WEBHOOK_URL=your-make-complete-108-webhook-url
MAKE_MESSAGES_WEBHOOK_URL=your-make-messages-webhook-url
MAKE_SUGGESTIONS_WEBHOOK_URL=your-make-suggestions-webhook-url
MAKE_CALLBACK_SECRET=change-this-random-secret
CRON_SECRET=change-this-random-cron-secret

# Feedback
FORMSPREE_ENDPOINT=your-feedback-form-endpoint

# Admin
ADMIN_EMAILS=admin@example.com
ADMIN_USER_IDS=

# Monitoring
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_REPLAY_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAY_ERROR_SAMPLE_RATE=0

# Optional AI
OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_MODEL=gpt-5-mini
OPENAI_SEARCH_MODEL=gpt-5-mini
OPENAI_SUGGESTIONS_MODEL=gpt-5-mini

# Required in production for costly API routes
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
